{
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "functions": {
    "api/nudge.mjs": { "includeFiles": "data/**/*.js" },
    "api/nudge-tick.mjs": { "includeFiles": "data/**/*.js" }
  },
  "crons": [
    { "path": "/api/nudge-tick", "schedule": "* * * * *" }
  ]
}
